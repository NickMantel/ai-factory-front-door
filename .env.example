# Copy to .env.local and fill in.
ANTHROPIC_API_KEY=

# Optional
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_CHAT_EFFORT=medium        # low | medium | high
# CLAUDE_ASSESS_EFFORT=low         # live canvas assessment after each intake turn
# CLAUDE_ANALYSIS_EFFORT=medium    # brief and insight generation
# FRAMEWORK=default                # which frameworks/<name>.md to assess against (read at build time)
# DATABASE_PATH=./data/frontdoor.db
# ACCESS_PASSWORD=                 # if set, visitors must enter it (any username); leave unset locally
# SESSION_SECRET=                  # signs sign-in cookies; falls back to ACCESS_PASSWORD, then a local default
# COE_EMAILS=a@org.com,b@org.com   # who may sign in as the AI CoE; unset lets anyone choose it (demo)
